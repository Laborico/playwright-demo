{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "@playwright/test"],
    "noEmit": true,
    "paths": {
      "@fixtures/*": ["./fixtures/*"],
      "@api/*": ["./api/*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "env.d.ts",
    "helpers/*.ts"
  ]
}
